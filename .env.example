# Copy this file to ".env" and fill in the values. Never commit .env.

# The DEDICATED X account used for collection (NOT @acmetrading).
X_ACCOUNT_USERNAME=your_dedicated_account_username

# Cookies copied from the browser after logging into that account on x.com
# (DevTools > Application > Cookies > https://x.com)
X_AUTH_TOKEN=paste_auth_token_value_here
X_CT0=paste_ct0_value_here

# Sentiment backend: auto | vader | transformers
SENTIMENT_BACKEND=auto

# Storage (optional). Leave both empty to keep the database in ./data and the model
# in the default Hugging Face cache, or point them at another drive.
DATA_DIR=
HF_HOME=

# Dashboard
WEB_HOST=127.0.0.1
WEB_PORT=8000
DASHBOARD_PASSWORD=change-me
# Optional second password for colleagues/testers: they can see everything but change nothing.
VIEWER_PASSWORD=
